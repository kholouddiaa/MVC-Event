@model MVC_Event.ViewModel.EventVM

<h1>Details</h1>

<div class="container mt-4">
    <table class="table table-hover table-striped text-center">
        <thead class="table-dark">
            <tr>
                <th>Title</th>
                <th>Description</th>
                <th>Date</th>
                <th>Organizer</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody class="table-light text-dark">
            <tr>
                <td>@Model.Title</td>
                <td>@Model.Description</td>
                <td>@Model.Date.ToShortDateString()</td>
                <td>@Model.OrganizerName</td>
                <td>
                    <a class="btn btn-secondary" asp-action="Index" asp-controller="Event">Back</a>
                    @if (!Model.UserHasBooked)
                    {
                        <a class="btn btn-primary" asp-action="Book" asp-controller="Booking" asp-route-id="@Model.Id">Book</a>
                    }
                    else
                    {
                        <span class="badge bg-success">Already Booked</span>
                    }
                </td>
            </tr>
        </tbody>
    </table>
</div>
