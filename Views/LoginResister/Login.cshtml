@{
    ViewData["Title"] = "Login";
}

<h1 class="mb-4 text-center text-dark">Login</h1>

<div class="container d-flex justify-content-center">
    <div class="card shadow-lg p-4 bg-light text-dark" style="width: 400px;">
        <form asp-action="Login" asp-controller="LoginResister" method="post">
            <div class="mb-3">
                <label for="UserName" class="form-label fw-bold">UserName</label>
                <input type="text" name="UserName" id="UserName" class="form-control" placeholder="Enter Your UserName" />
            </div>

            <div class="mb-3">
                <label for="Password" class="form-label fw-bold">Password</label>
                <input type="password" name="Password" id="Password" class="form-control" placeholder="Enter Your Password" />
            </div>

            <button type="submit" class="btn btn-success w-100">Login</button>

            <div class="mt-3 text-center">
                <a asp-action="Register" asp-controller="LoginResister" class="btn btn-link text-dark">Go to Register</a>
            </div>

            @if (ViewBag.Msg != null)
            {
                <p class="text-danger mt-2 text-center">@ViewBag.Msg</p>
            }
        </form>
    </div>
</div>
